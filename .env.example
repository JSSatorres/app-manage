# Variables de test E2E (nombres, sin valores). Copia a .env.test.local con valores reales.
# .env.test.local está git-ignored — NUNCA subas valores reales.

E2E_BASE_URL=
E2E_TEST_USER=
E2E_TEST_PASSWORD=
E2E_STORAGE_STATE=

# Identidades sintéticas por rol para la verificación de Sesiones. Sin valores reales.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ENTRENADOR_EMAIL=
E2E_ENTRENADOR_PASSWORD=
E2E_GERENTE_SEDE_EMAIL=
E2E_GERENTE_SEDE_PASSWORD=
E2E_JUGADOR_EMAIL=
E2E_JUGADOR_PASSWORD=
E2E_WORKSPACE_ID=
E2E_SESIONES_FIXTURE_ID=
E2E_SESIONES_SEDE_ID=
E2E_SESIONES_EQUIPO_ID=
E2E_SESIONES_EJERCICIO_ID=
E2E_SESIONES_DOCUMENTO_ID=

# Lista de espera Satorus (se configuran en el proveedor/deploy, nunca con valores reales en git).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Servicios server-only para Stripe test mode. Nunca subas valores reales.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
